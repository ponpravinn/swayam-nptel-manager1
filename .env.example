# ========================================================
# SWAYAM NPTEL Assignment Manager - Environment Template
# ========================================================
# Copy this file to .env or configure these variables in Railway/Render/Docker.
# NEVER commit your real .env file or credentials to GitHub!

# Application Port (provided automatically by Railway as PORT)
PORT=8080
APP_BASE_URL=http://localhost:8080
APP_ADMIN_EMAIL=admin@nptelmanager.com

# Active Spring Profile: 'default' (embedded H2) or 'mysql' (production MySQL)
SPRING_PROFILES_ACTIVE=default

# Database Configuration (Required only when SPRING_PROFILES_ACTIVE=mysql)
# If using Railway MySQL, Railway automatically injects MYSQLHOST, MYSQLPORT, etc.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=npteldb
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Email Notification Configuration (Optional)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
